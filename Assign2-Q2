#include <iostream>
using namespace std;

class Calculator {
private:
	int num1;
	int num2;
	int result;
public:
	void InputData() {
		cout << "Enter first number :" << num1 << endl;
		cout << "Enter second number :" << num2 << endl;

	}

	void Sum() {
		 result = num1 + num2;
	}

	void Display() {
		cout << "The sum of two numbers \n" << result << endl;
	}
};
int main() {
	Calculator C;
	C.InputData();
	C.Sum();
	C.Display();

	return 0;
}
